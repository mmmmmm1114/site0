<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <title>VOIDWEAR — Future Streetwear</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    /* -------------------- CORE -------------------- */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: "Inter", sans-serif;
      background: #000;
      color: #fff;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }

    /* -------------------- NAV -------------------- */
    nav {
      width: 100%;
      padding: 24px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 100;
      backdrop-filter: blur(12px);
      background: rgba(0,0,0,0.4);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .logo {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.15em;
    }
    .nav-links {
      display: flex;
      gap: 32px;
      font-size: 14px;
      opacity: 0.8;
    }
    .nav-links a:hover { opacity: 1; }

    /* -------------------- HERO -------------------- */
    .hero {
      height: 100vh;
      display: flex;
      align-items: center;
      padding: 0 40px;
      position: relative;
    }

    .hero-title {
      font-size: clamp(48px, 8vw, 120px);
      font-weight: 700;
      line-height: 0.9;
      letter-spacing: -0.03em;
      max-width: 700px;
      z-index: 2;
    }

    .hero-sub {
      margin-top: 20px;
      font-size: 18px;
      max-width: 420px;
      opacity: 0.7;
    }

    .hero-btns {
      margin-top: 30px;
      display: flex;
      gap: 16px;
    }

    .btn {
      padding: 12px 26px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.05);
      cursor: pointer;
      transition: 0.25s;
      font-size: 14px;
    }
    .btn:hover {
      background: rgba(255,255,255,0.15);
    }
    .btn-primary {
      background: #fff;
      color: #000;
      font-weight: 600;
    }
    .btn-primary:hover {
      background: #e5e5e5;
    }

    .hero-img {
      position: absolute;
      right: 0;
      top: 0;
      height: 100%;
      width: 50%;
      background: url('https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
      filter: brightness(0.7);
      animation: fadeIn 1.6s ease-out forwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: scale(1.05); }
      to { opacity: 1; transform: scale(1); }
    }

    /* -------------------- COLLECTIONS -------------------- */
    .section {
      padding: 120px 40px;
    }

    .section-title {
      font-size: 42px;
      margin-bottom: 40px;
      letter-spacing: -0.02em;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    .card {
      position: relative;
      height: 420px;
      border-radius: 20px;
      overflow: hidden;
      cursor: pointer;
      transition: 0.4s;
    }
    .card:hover { transform: translateY(-6px); }

    .card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.75);
      transition: 0.4s;
    }
    .card:hover img { filter: brightness(0.95); }

    .card-title {
      position: absolute;
      bottom: 20px;
      left: 20px;
      font-size: 24px;
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    /* -------------------- PRODUCTS -------------------- */
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }

    .product {
      background: #111;
      border-radius: 16px;
      padding: 16px;
      transition: 0.3s;
      border: 1px solid rgba(255,255,255,0.06);
    }
    .product:hover {
      transform: translateY(-4px);
      background: #181818;
    }

    .product img {
      width: 100%;
      border-radius: 12px;
      margin-bottom: 12px;
    }

    .product-title {
      font-size: 16px;
      margin-bottom: 6px;
    }

    .product-price {
      font-size: 14px;
      opacity: 0.7;
    }

    /* -------------------- FOOTER -------------------- */
    footer {
      padding: 40px;
      text-align: center;
      opacity: 0.6;
      font-size: 14px;
      border-top: 1px solid rgba(255,255,255,0.08);
      margin-top: 80px;
    }

    /* -------------------- RESPONSIVE -------------------- */
    @media (max-width: 900px) {
      .hero-img { display: none; }
      .hero { padding-top: 120px; }
    }
  </style>
</head>

<body>

  <!-- NAV -->
  <nav>
    <div class="logo">VOIDWEAR</div>
    <div class="nav-links">
      <a href="#collections">Колекції</a>
      <a href="#products">Новинки</a>
      <a href="#about">Про бренд</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div>
      <h1 class="hero-title">Майбутнє<br>стрітвиру.</h1>
      <p class="hero-sub">Технічні тканини. Чисті лінії. Силуети нового покоління.</p>

      <div class="hero-btns">
        <button class="btn-primary btn">Переглянути</button>
        <button class="btn">Лукбук</button>
      </div>
    </div>

    <div class="hero-img"></div>
  </section>

  <!-- COLLECTIONS -->
  <section class="section" id="collections">
    <h2 class="section-title">Колекції</h2>

    <div class="grid">
      <div class="card">
        <img src="https://images.unsplash.com/photo-1523381294911-8d3cead13475?auto=format&fit=crop&w=900&q=80">
        <div class="card-title">Urban Core</div>
      </div>

      <div class="card">
        <img src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=900&q=80">
        <div class="card-title">Night Division</div>
      </div>

      <div class="card">
        <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?auto=format&fit=crop&w=900&q=80">
        <div class="card-title">Tech Motion</div>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section" id="products">
    <h2 class="section-title">Новинки</h2>

    <div class="product-grid">
      <div class="product">
        <img src="https://images.unsplash.com/photo-1602810318383-e386cc2a3f3e?auto=format&fit=crop&w=900&q=80">
        <div class="product-title">Hoodie “Zero Pulse”</div>
        <div class="product-price">€129</div>
      </div>

      <div class="product">
        <img src="https://images.unsplash.com/photo-1542272604-787c3835535d?auto=format&fit=crop&w=900&q=80">
        <div class="product-title">Shell Jacket “Vortex”</div>
        <div class="product-price">€189</div>
      </div>

      <div class="product">
        <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?auto=format&fit=crop&w=900&q=80">
        <div class="product-title">Tech Pants “Axis”</div>
        <div class="product-price">€139</div>
      </div>

      <div class="product">
        <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=900&q=80">
        <div class="product-title">T-shirt “Signal”</div>
        <div class="product-price">€59</div>
      </div>
    </div>
  </section>

  <footer>
    © 2026 VOIDWEAR. Усі права захищені.
  </footer>

</body>
</html>
