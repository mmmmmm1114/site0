<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8" />
  <title>MONSTER STUDIO — Dynamic Edition</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, sans-serif;
    }

    body {
      background: #000;
      color: #fff;
      overflow-x: hidden;
    }

    /* HEADER */
    header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 20px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #222;
      z-index: 1000;
      animation: fadeDown 1s ease forwards;
      opacity: 0;
    }

    @keyframes fadeDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .logo {
      font-size: 18px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
    }

    nav a {
      margin-left: 20px;
      text-transform: uppercase;
      font-size: 12px;
      opacity: 0.7;
      text-decoration: none;
      color: #fff;
      transition: 0.3s;
    }

    nav a:hover {
      opacity: 1;
      transform: scale(1.1);
    }

    main {
      padding-top: 120px;
    }

    /* HERO */
    .hero {
      display: flex;
      justify-content: space-between;
      padding: 80px 40px;
      gap: 40px;
      align-items: center;
    }

    .hero-left {
      animation: slideLeft 1.2s ease forwards;
      opacity: 0;
    }

    @keyframes slideLeft {
      from { opacity: 0; transform: translateX(-60px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .hero-left h1 {
      font-size: 52px;
      letter-spacing: 0.1em;
      margin-bottom: 20px;
      text-transform: uppercase;
      line-height: 1.2;
    }

    .hero-left p {
      max-width: 400px;
      opacity: 0.8;
      margin-bottom: 20px;
      line-height: 1.6;
    }

    .btn-primary {
      background: #fff;
      color: #000;
      padding: 12px 26px;
      border-radius: 50px;
      border: none;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      transition: 0.3s;
    }

    .btn-primary:hover {
      transform: scale(1.1);
      background: #ddd;
    }

    .hero-card {
      background: #111;
      padding: 40px;
      border-radius: 20px;
      border: 1px solid #333;
      max-width: 320px;
      text-align: center;
      animation: slideRight 1.2s ease forwards;
      opacity: 0;
    }

    @keyframes slideRight {
      from { opacity: 0; transform: translateX(60px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .hero-card:hover {
      transform: translateY(-10px);
      transition: 0.4s;
    }

    /* PRODUCTS */
    .products {
      padding: 40px;
    }

    .products h2 {
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      opacity: 0;
      animation: fadeUp 1s ease forwards;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .item {
      background: #111;
      padding: 20px;
      border-radius: 16px;
      border: 1px solid #222;
      transform: translateY(40px);
      opacity: 0;
      transition: 0.6s;
    }

    .item.visible {
      transform: translateY(0);
      opacity: 1;
    }

    .img {
      background: #333;
      height: 220px;
      display: flex;
      justify-content: center;
      align-items: center;
      text-transform: uppercase;
      font-size: 12px;
      opacity: 0.8;
      margin-bottom: 10px;
      transition: 0.4s;
    }

    .item:hover .img {
      transform: scale(1.05);
    }

    .info {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
    }

    /* ABOUT + CONTACT */
    .about, .contact {
      padding: 40px;
      opacity: 0;
      transform: translateY(40px);
      transition: 0.8s;
    }

    .section-visible {
      opacity: 1 !important;
      transform: translateY(0) !important;
    }

    footer {
      padding: 20px 40px;
      border-top: 1px solid #222;
      opacity: 0.7;
      margin-top: 40px;
      text-align: center;
    }
  </style>
</head>

<body>
  <header>
    <div class="logo">MONSTER STUDIO</div>
    <nav>
      <a href="#shop">Shop</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-left">
        <h1>New season.<br>Same attitude.</h1>
        <p>Мінімалістичний бренд одягу з акцентом на силует, текстуру та тишу.</p>
        <button class="btn-primary">Переглянути колекцію</button>
      </div>

      <div class="hero-right">
        <div class="hero-card">
          <h2>VOID LINE</h2>
          <p>Лімітована капсула в чорних та графітових відтінках.</p>
        </div>
      </div>
    </section>

    <section id="shop" class="products">
      <h2>Featured pieces</h2>

      <div class="grid">
        <div class="item"><div class="img">Oversized hoodie</div><div class="info"><span>Void Hoodie</span><span>€140</span></div></div>
        <div class="item"><div class="img">Technical cargo</div><div class="info"><span>Night Cargo</span><span>€180</span></div></div>
        <div class="item"><div class="img">Minimal sneaker</div><div class="info"><span>Base Sneaker</span><span>€220</span></div></div>
      </div>
    </section>

    <section id="about" class="about">
      <h2>About</h2>
      <p>Це концепт‑сайт у стилі Balenciaga / Nike. Ти можеш змінити назву, тексти та фото.</p>
    </section>

    <section id="contact" class="contact">
      <h2>Contact</h2>
      <p>Email: hello@monster.fake</p>
    </section>
  </main>

  <footer>
    © 2026 MONSTER STUDIO
  </footer>

  <script>
    // Анімація появи елементів при скролі
    const items = document.querySelectorAll('.item');
    const sections = document.querySelectorAll('.about, .contact');

    function reveal() {
      items.forEach(el => {
        const top = el.getBoundingClientRect().top;
        if (top < window.innerHeight - 100) el.classList.add('visible');
      });

      sections.forEach(sec => {
        const top = sec.getBoundingClientRect().top;
        if (top < window.innerHeight - 100) sec.classList.add('section-visible');
      });
    }

    window.addEventListener('scroll', reveal);
    reveal();
  </script>
</body>
</html>

