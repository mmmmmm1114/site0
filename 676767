// ==================== DRAWING ====================

function drawGround(ctx, camX, camY) {
    // Grass background
    ctx.fillStyle = '#3a6b1f';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Grid pattern
    ctx.strokeStyle = 'rgba(0,0,0,0.05)';
    ctx.lineWidth = 1;
    const gridSize = 100;
    const offsetX = -camX % gridSize;
    const offsetY = -camY % gridSize;
    
    for (let x = offsetX; x < canvas.width; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
    }
    for (let y = offsetY; y < canvas.height; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
    }

    // Draw roads
    for (let road of roads) {
        const x1 = road.x1 - camX;
        const y1 = road.y1 - camY;
        const x2 = road.x2 - camX;
        const y2 = road.y2 - camY;

        // Road shadow
        ctx.strokeStyle = 'rgba(0,0,0,0.2)';
        ctx.lineWidth = road.width + 4;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();

        // Road surface
        ctx.strokeStyle = '#555';
        ctx.lineWidth = road.width;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();

        // Road lines
        ctx.strokeStyle = '#777';
        ctx.lineWidth = 2;
        ctx.setLineDash([15, 15]);
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
        ctx.setLineDash([]);
    }

    // Draw buildings
    for (let b of buildings) {
        const bx = b.x - camX;
        const by = b.y - camY;
        
        // Shadow
        ctx.fillStyle = 'rgba(0,0,0,0.2)';
        ctx.fillRect(bx + 5, by + 5, b.w, b.h);
        
        // Building
        ctx.fillStyle = b.color;
        ctx.fillRect(bx, by, b.w, b.h);
        
        // Roof
        ctx.fillStyle = 'rgba(0,0,0,0.1)';
        ctx.fillRect(bx, by, b.w, 5);
        
        // Windows
        ctx.fillStyle = '#87CEEB';
        for (let wx = 5; wx < b.w - 10; wx += 15) {
            for (let wy = 10; wy < b.h - 10; wy += 20) {
                if (Math.random() > 0.3) {
                    ctx.fillRect(bx + wx, by + wy, 8, 12);
                }
            }
        }
    }

    // Draw gas stations
    for (let g of gasStations) {
        const gx = g.x - camX;
        const gy = g.y - camY;
        const size = g.size;

        // Station area
        ctx.fillStyle = g.large ? 'rgba(200,200,200,0.3)' : 'rgba(180,180,180,0.2)';
        ctx.beginPath();
        ctx.arc(gx, gy, size / 2, 0, Math.PI * 2);
        ctx.fill();

        // Canopy
        ctx.fillStyle = g.large ? '#cc3333' : '#dd4444';
        ctx.fillRect(gx - size/3, gy - size/4, size/1.5, size/2);
        
        // Pillars
        ctx.fillStyle = '#888';
        ctx.fillRect(gx - size/3 + 5, gy - size/4, 4, size/2);
        ctx.fillRect(gx + size/3 - 9, gy - size/4, 4, size/2);

        // Pumps
        ctx.fillStyle = '#333';
        for (let i = -1; i <= 1; i++) {
            ctx.fillRect(gx + i * 12 - 3, gy + 5, 6, 10);
        }

        // Sign
        ctx.fillStyle = '#ffcc00';
        ctx.font = g.large ? 'bold 14px Arial' : 'bold 10px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('⛽', gx, gy - size/4 - 5);

        if (g.large) {
            ctx.fillStyle = '#ffcc00';
            ctx.font = 'bold 10px Arial';
            ctx.fillText('АЗС', gx, gy + size/2 + 12);
        }

        // Glow effect for healing
        ctx.strokeStyle = 'rgba(0,255,0,0.3)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(gx, gy, size/2 + Math.sin(gameTime * 0.1) * 5, 0, Math.PI * 2);
        ctx.stroke();
    }

    // Draw trees
    for (let tree of trees) {
        const tx = tree.x - camX;
        const ty = tree.y - camY;

        // Shadow
        ctx.fillStyle = 'rgba(0,0,0,0.15)';
        ctx.beginPath();
        ctx.arc(tx + 3, ty + 3, tree.size * 0.6, 0, Math.PI * 2);
        ctx.fill();

        if (tree.type === 'pine') {
            // Pine tree
            ctx.fillStyle = '#1a5c1a';
            ctx.beginPath();
            ctx.moveTo(tx, ty - tree.size);
            ctx.lineTo(tx - tree.size * 0.4, ty + tree.size * 0.3);
            ctx.lineTo(tx + tree.size * 0.4, ty + tree.size * 0.3);
            ctx.fill();
            
            ctx.fillStyle = '#0d4d0d';
            ctx.beginPath();
            ctx.moveTo(tx, ty - tree.size * 0.7);
            ctx.lineTo(tx - tree.size * 0.3, ty + tree.size * 0.1);
            ctx.lineTo(tx + tree.size * 0.3, ty + tree.size * 0.1);
            ctx.fill();
        } else {
            // Oak tree
            ctx.fillStyle = '#2d7a2d';
            ctx.beginPath();
            ctx.arc(tx, ty - tree.size * 0.3, tree.size * 0.5, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.fillStyle = '#1e5c1e';
            ctx.beginPath();
            ctx.arc(tx - tree.size * 0.2, ty - tree.size * 0.5, tree.size * 0.35, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.fillStyle = '#246b24';
            ctx.beginPath();
            ctx.arc(tx + tree.size * 0.2, ty - tree.size * 0.4, tree.size * 0.3, 0, Math.PI * 2);
            ctx.fill();
        }

        // Trunk
        ctx.fillStyle = '#5c3a1e';
        ctx.fillRect(tx - 2, ty, 4, tree.size * 0.4);
    }
}

function drawRain(ctx) {
    ctx.strokeStyle = 'rgba(150, 150, 200, 0.4)';
    ctx.lineWidth = 1;
    
    for (let i = 0; i < rainDrops.length; i++) {
        const drop = rainDrops[i];
        drop.y += drop.speed;
        drop.x += drop.wind;
        
        if (drop.y > canvas.height) {
            drop.y = -10;
            drop.x = Math.random() * canvas.width;
        }
        
        ctx.beginPath();
        ctx.moveTo(drop.x, drop.y);
        ctx.lineTo(drop.x + drop.wind, drop.y + drop.length);
        ctx.stroke();
    }
}

function drawMinimap() {
    const mmw = minimapCanvas.width;
    const mmh = minimapCanvas.height;
    const scaleX = mmw / MAP_WIDTH;
    const scaleY = mmh / MAP_HEIGHT;

    minimapCtx.fillStyle = '#1a3a0a';
    minimapCtx.fillRect(0, 0, mmw, mmh);

    // Roads
    minimapCtx.strokeStyle = '#555';
    minimapCtx.lineWidth = 1;
    for (let road of roads) {
        minimapCtx.beginPath();
        minimapCtx.moveTo(road.x1 * scaleX, road.y1 * scaleY);
        minimapCtx.lineTo(road.x2 * scaleX, road.y2 * scaleY);
        minimapCtx.stroke();
    }

    // Gas stations
    minimapCtx.fillStyle = '#ffcc00';
    for (let g of gasStations) {
        minimapCtx.fillRect(g.x * scaleX - 2, g.y * scaleY - 2, 4, 4);
    }

    // Tornadoes
    for (let t of tornadoes) {
        minimapCtx.fillStyle = t.isFinal ? '#ff0000' : '#6666ff';
        minimapCtx.beginPath();
        minimapCtx.arc(t.pos.x * scaleX, t.pos.y * scaleY, t.isFinal ? 6 : 3, 0, Math.PI * 2);
        minimapCtx.fill();
    }

    // Cars
    for (let car of cars) {
        if (!car.alive) continue;
        minimapCtx.fillStyle = car.isPlayer ? '#ff0000' : car.color;
        minimapCtx.fillRect(car.pos.x * scaleX - 2, car.pos.y * scaleY - 2, 4, 4);
    }

    // Viewport rectangle
    minimapCtx.strokeStyle = 'rgba(255,255,255,0.5)';
    minimapCtx.lineWidth = 1;
    minimapCtx.strokeRect(
        camera.x * scaleX,
        camera.y * scaleY,
        canvas.width * scaleX,
        canvas.height * scaleY
    );
}

function drawRadar() {
    const rcw = radarCanvas.width;
    const rch = radarCanvas.height;
    const cx = rcw / 2;
    const cy = rch / 2;

    // Background
    radarCtx.fillStyle = 'rgba(0, 20, 0, 0.9)';
    radarCtx.fillRect(0, 0, rcw, rch);

    // Grid circles
    radarCtx.strokeStyle = 'rgba(0, 255, 0, 0.3)';
    radarCtx.lineWidth = 1;
    for (let r = 20; r < 80; r += 20) {
        radarCtx.beginPath();
        radarCtx.arc(cx, cy, r, 0, Math.PI * 2);
        radarCtx.stroke();
    }

    // Crosshairs
    radarCtx.beginPath();
    radarCtx.moveTo(cx, 0);
    radarCtx.lineTo(cx, rch);
    radarCtx.moveTo(0, cy);
    radarCtx.lineTo(rcw, cy);
    radarCtx.stroke();

    // Wind direction from tornadoes
    for (let t of tornadoes) {
        const dx = t.pos.x - player.pos.x;
        const dy = t.pos.y - player.pos.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const maxDist = 1000;
        
        if (dist < maxDist) {
            const angle = Math.atan2(dy, dx);
            const r = (dist / maxDist) * 70;
            const px = cx + Math.cos(angle) * r;
            const py = cy + Math.sin(angle) * r;

            // Wind arrow
            radarCtx.strokeStyle = t.isFinal ? '#ff0000' : '#00ff00';
            radarCtx.lineWidth = 2;
            radarCtx.beginPath();
            radarCtx.moveTo(cx, cy);
            radarCtx.lineTo(px, py);
            radarCtx.stroke();

            // Dot
            radarCtx.fillStyle = t.isFinal ? '#ff0000' : '#00ff00';
            radarCtx.beginPath();
            radarCtx.arc(px, py, t.isFinal ? 5 : 3, 0, Math.PI * 2);
            radarCtx.fill();

            // Distance text
            radarCtx.fillStyle = '#00ff00';
            radarCtx.font = '10px Arial';
            radarCtx.fillText(Math.floor(dist) + 'м', px + 5, py);
        }
    }

    // Player center
    radarCtx.fillStyle = '#ffff00';
    radarCtx.beginPath();
    radarCtx.arc(cx, cy, 4, 0, Math.PI * 2);
    radarCtx.fill();

    // Sweep effect
    const sweepAngle = (gameTime * 0.05) % (Math.PI * 2);
    radarCtx.strokeStyle = 'rgba(0, 255, 0, 0.5)';
    radarCtx.lineWidth = 2;
    radarCtx.beginPath();
    radarCtx.moveTo(cx, cy);
    radarCtx.lineTo(cx + Math.cos(sweepAngle) * 75, cy + Math.sin(sweepAngle) * 75);
    radarCtx.stroke();
}

function updateLeaderboard() {
    const sorted = [...cars].sort((a, b) => {
        if (a.alive && !b.alive) return -1;
        if (!a.alive && b.alive) return 1;
        return b.health - a.health;
    });

    let html = '';
    for (let i = 0; i < sorted.length; i++) {
        const car = sorted[i];
        const status = car.alive ? `❤️${Math.floor(car.health)}` : '💀';
        const me = car.isPlayer ? 'me' : '';
        html += `<div class="leader-item ${me}">${i+1}. ${car.name} <span>${status}</span></div>`;
    }
    document.getElementById('leaderList').innerHTML = html;
}

function addMessage(text, color = 'white') {
    const msg = document.createElement('div');
    msg.className = 'msg';
    msg.style.color = color;
    msg.textContent = text;
    document.getElementById('messages').appendChild(msg);
    setTimeout(() => msg.remove(), 3000);
}

function showPhaseMessage(text) {
    const el = document.getElementById('phaseIndicator');
    el.textContent = text;
    el.style.opacity = '1';
    setTimeout(() => el.style.opacity = '0', 3000);
}

function formatTime(seconds) {
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${s.toString().padStart(2, '0')}`;
}

// ==================== MAIN LOOP ====================

function gameLoop() {
    if (!gameRunning) return;

    // Update time
    gameTime += 1/60;
    phaseTime += 1/60;

    // Phase management
    if (phase === 'storm' && phaseTime > 60) {
        phase = 'tornado';
        phaseTime = 0;
        showPhaseMessage('🌪️ ФІНАЛЬНЕ ТОРНАДО З\'ЯВИЛОСЯ! ДОТОРКНИСЬ ДО НЬОГО ПЕРШИМ!');
        spawnTornadoes();
        addMessage('⚠️ Всі торнадо злилися в одне величезне!', '#ff6666');
    }

    // Update camera (follow player)
    if (player.alive) {
        camera.x = player.pos.x - canvas.width / 2;
        camera.y = player.pos.y - canvas.height / 2;
    }
    camera.x = Math.max(0, Math.min(MAP_WIDTH - canvas.width, camera.x));
    camera.y = Math.max(0, Math.min(MAP_HEIGHT - canvas.height, camera.y));

    // Screen shake
    let shakeX = 0, shakeY = 0;
    if (screenShake > 0) {
        shakeX = (Math.random() - 0.5) * screenShake;
        shakeY = (Math.random() - 0.5) * screenShake;
        screenShake *= 0.9;
        if (screenShake < 0.5) screenShake = 0;
    }

    // Clear canvas
    ctx.fillStyle = '#2d5016';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.save();
    ctx.translate(shakeX, shakeY);

    // Draw world
    drawGround(ctx, camera.x, camera.y);

    // Update and draw tornadoes
    for (let t of tornadoes) {
        t.update();
        t.draw(ctx, camera.x, camera.y);
    }

    // Update and draw interceptors
    for (let i of interceptors) {
        i.update();
        i.draw(ctx, camera.x, camera.y);
    }

    // Update and draw cars
    for (let car of cars) {
        car.update(keys);
        car.draw(ctx, camera.x, camera.y);
    }

    // Rain in storm phase
    if (phase === 'storm') {
        drawRain(ctx);
    }

    ctx.restore();

    // Update UI
    document.getElementById('fuelDisplay').textContent = Math.floor(player.fuel) + '%';
    document.getElementById('healthDisplay').textContent = Math.floor(player.health) + '%';
    document.getElementById('speedDisplay').textContent = Math.floor(Math.abs(player.speed) * 10);
    document.getElementById('phaseDisplay').textContent = phase === 'storm' ? '⛈️ Шторм' : '🌪️ Торнадо';
    document.getElementById('timeDisplay').textContent = formatTime(gameTime);

    // Update minimap and radar
    drawMinimap();
    drawRadar();
    updateLeaderboard();

    // Check collisions
    checkCollisions();

    // Check if all bots dead and player alive = win
    const aliveBots = cars.filter(c => !c.isPlayer && c.alive).length;
    if (phase === 'tornado' && aliveBots === 0 && player.alive) {
        playerWon();
    }

    requestAnimationFrame(gameLoop);
}

// ==================== GAME CONTROL ====================

function startGame() {
    document.getElementById('menu').style.opacity = '0';
    setTimeout(() => {
        document.getElementById('menu').style.display = 'none';
    }, 500);
    
    document.getElementById('deathScreen').style.display = 'none';
    document.getElementById('gameUI').style.display = 'block';
    
    canvas.style.display = 'block';
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    // Reset game state
    gameRunning = true;
    gameTime = 0;
    phaseTime = 0;
    phase = 'storm';
    screenShake = 0;

    // Generate rain
    rainDrops = [];
    for (let i = 0; i < 100; i++) {
        rainDrops.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            speed: 5 + Math.random() * 10,
            length: 10 + Math.random() * 15,
            wind: -2 + Math.random() * 4
        });
    }

    generateMap();
    spawnCars();
    spawnTornadoes();

    showPhaseMessage('⛈️ ФАЗА ШТОРМУ! Уникай торнадо та збирай ресурси!');
    addMessage('Гра почалася! Уникай торнадо!', '#66ff66');

    gameLoop();
}

function backToMenu() {
    gameRunning = false;
    document.getElementById('deathScreen').style.display = 'none';
    document.getElementById('gameUI').style.display = 'none';
    canvas.style.display = 'none';
    
    const menu = document.getElementById('menu');
    menu.style.display = 'flex';
    setTimeout(() => menu.style.opacity = '1', 10);
}

function showSettings() {
    document.getElementById('settings').style.display = 'flex';
    document.getElementById('playerName').value = playerName;
}

function hideSettings() {
    playerName = document.getElementById('playerName').value || 'Гравець';
    localStorage.setItem('tornado_name', playerName);
    sensitivity = parseInt(document.getElementById('sensitivity').value);
    volume = parseInt(document.getElementById('volume').value);
    document.getElementById('settings').style.display = 'none';
}

function showHowTo() {
    document.getElementById('howTo').style.display = 'flex';
}

function hideHowTo() {
    document.getElementById('howTo').style.display = 'none';
}

// Window resize
window.addEventListener('resize', () => {
    if (gameRunning) {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
});

// Load saved settings
document.getElementById('playerName').value = playerName;
</script>

