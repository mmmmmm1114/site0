// ==================== GENERATION ====================

function generateMap() {
    roads = [];
    gasStations = [];
    trees = [];
    buildings = [];
    interceptors = [];

    // Generate road network (grid + some random)
    const gridSize = 400;
    for (let x = 0; x <= MAP_WIDTH; x += gridSize) {
        roads.push({ x1: x, y1: 0, x2: x, y2: MAP_WIDTH, width: 30 });
    }
    for (let y = 0; y <= MAP_HEIGHT; y += gridSize) {
        roads.push({ x1: 0, y1: y, x2: MAP_WIDTH, y2: y, width: 30 });
    }

    // Diagonal roads
    roads.push({ x1: 0, y1: 0, x2: MAP_WIDTH, y2: MAP_HEIGHT, width: 20 });
    roads.push({ x1: MAP_WIDTH, y1: 0, x2: 0, y2: MAP_HEIGHT, width: 20 });

    // Random curved roads
    for (let i = 0; i < 5; i++) {
        const rx = 200 + Math.random() * (MAP_WIDTH - 400);
        const ry = 200 + Math.random() * (MAP_HEIGHT - 400);
        roads.push({
            x1: rx, y1: ry,
            x2: rx + (Math.random() - 0.5) * 600,
            y2: ry + (Math.random() - 0.5) * 600,
            width: 25, curved: true
        });
    }

    // Gas stations at intersections
    const intersections = [];
    for (let i = 0; i < roads.length; i++) {
        for (let j = i + 1; j < roads.length; j++) {
            const r1 = roads[i];
            const r2 = roads[j];
            // Simple intersection check
            if (Math.abs(r1.x1 - r1.x2) < 10 && Math.abs(r2.y1 - r2.y2) < 10) {
                intersections.push({ x: r1.x1, y: r2.y1 });
            }
            if (Math.abs(r1.y1 - r1.y2) < 10 && Math.abs(r2.x1 - r2.x2) < 10) {
                intersections.push({ x: r2.x1, y: r1.y1 });
            }
        }
    }

    // Add gas stations
    for (let i = 0; i < Math.min(intersections.length, 12); i++) {
        const idx = Math.floor(Math.random() * intersections.length);
        const inter = intersections[idx];
        gasStations.push({
            x: inter.x + (Math.random() - 0.5) * 60,
            y: inter.y + (Math.random() - 0.5) * 60,
            size: 40 + Math.random() * 30
        });
    }

    // Extra large gas stations
    for (let i = 0; i < 3; i++) {
        gasStations.push({
            x: 300 + Math.random() * (MAP_WIDTH - 600),
            y: 300 + Math.random() * (MAP_HEIGHT - 600),
            size: 80,
            large: true
        });
    }

    // Trees
    for (let i = 0; i < 300; i++) {
        trees.push({
            x: Math.random() * MAP_WIDTH,
            y: Math.random() * MAP_HEIGHT,
            size: 15 + Math.random() * 25,
            type: Math.random() > 0.5 ? 'pine' : 'oak'
        });
    }

    // Buildings
    for (let i = 0; i < 50; i++) {
        buildings.push({
            x: 100 + Math.random() * (MAP_WIDTH - 200),
            y: 100 + Math.random() * (MAP_HEIGHT - 200),
            w: 40 + Math.random() * 80,
            h: 40 + Math.random() * 80,
            color: `hsl(${30 + Math.random() * 30}, 20%, ${40 + Math.random() * 20}%)`
        });
    }
}

function spawnTornadoes() {
