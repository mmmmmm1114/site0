// ==================== COLLISION & LOGIC ====================

function checkCollisions() {
    // Car vs Tornado
    for (let car of cars) {
        if (!car.alive) continue;
        for (let t of tornadoes) {
            const dist = car.pos.dist(t.pos);
            if (dist < t.radius * 0.7) {
                // Being sucked in!
                const pull = t.pos.sub(car.pos).normalize().mult(3);
                car.pos = car.pos.add(pull);
                car.health -= 2;
                
                if (car.health <= 0) {
                    car.alive = false;
                    if (car.isPlayer) {
                        playerDied('Торнадо затягнуло тебе у вихор!');
                    } else {
                        addMessage(`💀 ${car.name} знищено торнадо!`, '#ff6666');
                    }
                }
            } else if (dist < t.radius) {
                car.health -= 0.5;
                // Push away slightly
                const push = car.pos.sub(t.pos).normalize().mult(1);
                car.pos = car.pos.add(push);
            }
        }
    }

    // Car vs Car
    for (let i = 0; i < cars.length; i++) {
        for (let j = i + 1; j < cars.length; j++) {
            const c1 = cars[i];
            const c2 = cars[j];
            if (!c1.alive || !c2.alive) continue;
            
            const dist = c1.pos.dist(c2.pos);
            if (dist < 30) {
                // Bounce
                const normal = c1.pos.sub(c2.pos).normalize();
                c1.pos = c1.pos.add(normal.mult(2));
                c2.pos = c2.pos.sub(normal.mult(2));
                c1.health -= 5;
                c2.health -= 5;
            }
        }
    }

    // Car vs Gas Station
    for (let car of cars) {
        if (!car.alive) continue;
        for (let g of gasStations) {
            const dist = car.pos.dist(new Vector2(g.x, g.y));
            if (dist < g.size / 2 + 20) {
                car.fuel = Math.min(100, car.fuel + 1);
                car.health = Math.min(100, car.health + 0.5);
            }
        }
    }

    // Interceptor vs Tornado (handled in Interceptor.update)

    // Check win condition (tornado phase)
    if (phase === 'tornado') {
        for (let car of cars) {
            if (!car.alive) continue;
            for (let t of tornadoes) {
                if (t.isFinal && car.pos.dist(t.pos) < t.radius * 0.5) {
                    // Touch the tornado!
                    if (car.isPlayer) {
                        playerWon();
                    } else {
                        addMessage(`🏆 ${car.name} переміг, доторкнувшись до торнадо!`, '#ffd700');
                    }
                    return;
                }
            }
        }
    }
}

