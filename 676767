<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tornado Chase - Штормова гонка</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0a0a0a;
            overflow: hidden;
            color: white;
        }

        /* ====== MENU ====== */
        #menu {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            transition: opacity 0.5s;
        }

        #menu h1 {
            font-size: 4em;
            text-shadow: 0 0 30px #e94560, 0 0 60px #e94560;
            margin-bottom: 10px;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        #menu .subtitle {
            font-size: 1.3em;
            color: #aaa;
            margin-bottom: 40px;
        }

        .menu-btn {
            padding: 15px 50px;
            margin: 10px;
            font-size: 1.3em;
            border: 2px solid #e94560;
            background: transparent;
            color: white;
            cursor: pointer;
            border-radius: 10px;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .menu-btn:hover {
            background: #e94560;
            box-shadow: 0 0 30px #e94560;
            transform: scale(1.1);
        }

        .menu-stats {
            margin-top: 30px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            text-align: center;
        }

        .stat-box {
            background: rgba(255,255,255,0.05);
            padding: 15px 25px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .stat-box .value {
            font-size: 2em;
            color: #e94560;
            font-weight: bold;
        }

        /* ====== GAME UI ====== */
        #gameUI {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 100;
            display: none;
        }

        #minimap {
            position: absolute;
            top: 20px; right: 20px;
            width: 200px; height: 200px;
            background: rgba(0,0,0,0.8);
            border: 2px solid #e94560;
            border-radius: 10px;
            overflow: hidden;
        }

        #minimap canvas {
            width: 100%; height: 100%;
        }

        #windRadar {
            position: absolute;
            top: 20px; left: 20px;
            width: 150px; height: 150px;
            background: rgba(0,20,0,0.9);
            border: 2px solid #00ff00;
            border-radius: 50%;
            overflow: hidden;
        }

        #windRadar canvas {
            width: 100%; height: 100%;
        }

        .radar-label {
            position: absolute;
            top: 175px; left: 20px;
            color: #00ff00;
            font-size: 0.9em;
            text-shadow: 0 0 10px #00ff00;
        }

        #hud {
            position: absolute;
            bottom: 20px; left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .hud-item {
            background: rgba(0,0,0,0.7);
            padding: 10px 20px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.2);
            text-align: center;
        }

        .hud-item .label {
            font-size: 0.8em;
            color: #aaa;
        }

        .hud-item .value {
            font-size: 1.5em;
            font-weight: bold;
        }

        #phaseIndicator {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            font-size: 3em;
            text-shadow: 0 0 30px white;
            opacity: 0;
            transition: opacity 1s;
            pointer-events: none;
        }

        #leaderboard {
            position: absolute;
            top: 240px; right: 20px;
            background: rgba(0,0,0,0.8);
            border: 1px solid #e94560;
            border-radius: 10px;
            padding: 15px;
            min-width: 180px;
        }

        #leaderboard h3 {
            color: #e94560;
            margin-bottom: 10px;
            text-align: center;
        }

        .leader-item {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .leader-item.me {
            color: #ffd700;
        }

        #messages {
            position: absolute;
            bottom: 120px; left: 50%;
            transform: translateX(-50%);
            text-align: center;
        }

        .msg {
            background: rgba(0,0,0,0.7);
            padding: 8px 20px;
            border-radius: 20px;
            margin: 5px;
            animation: fadeUp 3s forwards;
        }

        @keyframes fadeUp {
            0% { opacity: 0; transform: translateY(20px); }
            20% { opacity: 1; transform: translateY(0); }
            80% { opacity: 1; }
            100% { opacity: 0; transform: translateY(-20px); }
        }

        /* ====== CANVAS ====== */
        #gameCanvas {
            display: none;
            background: #2d5016;
        }

        #deathScreen {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 500;
        }

        #deathScreen h2 {
            font-size: 3em;
            color: #e94560;
            margin-bottom: 20px;
        }

        .skull {
            font-size: 5em;
            animation: shake 0.5s infinite;
        }

        @keyframes shake {
            0%, 100% { transform: rotate(-5deg); }
            50% { transform: rotate(5deg); }
        }

        #settings {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.95);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1001;
        }

        .setting-row {
            margin: 15px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .setting-row label {
            width: 200px;
            text-align: right;
        }

        .setting-row input[type="range"] {
            width: 200px;
        }

        .back-btn {
            margin-top: 30px;
        }
    </style>
</head>
<body>

<!-- ====== MENU ====== -->
<div id="menu">
    <h1>🌪️ TORNADO CHASE</h1>
    <p class="subtitle">Виживи в штормі. Знайди торнадо. Переможи!</p>
    <button class="menu-btn" onclick="startGame()">🎮 Грати</button>
    <button class="menu-btn" onclick="showSettings()">⚙️ Налаштування</button>
    <button class="menu-btn" onclick="showHowTo()">❓ Як грати</button>
    
    <div class="menu-stats">
        <div class="stat-box">
            <div class="label">Рекорд</div>
            <div class="value" id="bestScore">0</div>
        </div>
        <div class="stat-box">
            <div class="label">Ігор</div>
            <div class="value" id="gamesPlayed">0</div>
        </div>
        <div class="stat-box">
            <div class="label">Перемог</div>
            <div class="value" id="wins">0</div>
        </div>
    </div>
</div>

<!-- ====== SETTINGS ====== -->
<div id="settings">
    <h1>⚙️ Налаштування</h1>
    <div class="setting-row">
        <label>Ім'я гравця:</label>
        <input type="text" id="playerName" value="Гравець" style="padding:8px; font-size:1em; width:200px;">
    </div>
    <div class="setting-row">
        <label>Чутливість:</label>
        <input type="range" id="sensitivity" min="1" max="10" value="5">
    </div>
    <div class="setting-row">
        <label>Гучність:</label>
        <input type="range" id="volume" min="0" max="100" value="70">
    </div>
    <button class="menu-btn back-btn" onclick="hideSettings()">⬅️ Назад</button>
</div>

<!-- ====== HOW TO PLAY ====== -->
<div id="howTo" style="display:none; position:fixed; top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.95);z-index:1001;flex-direction:column;align-items:center;justify-content:center;padding:40px;">
    <h1>❓ Як грати</h1>
    <div style="max-width:600px; line-height:2; font-size:1.1em;">
        <p>🎮 <b>WASD</b> або <b>Стрілки</b> — керування машиною</p>
        <p>⛽ <b>Заправки</b> — відновлюють паливо та ремонтують машину</p>
        <p>🌪️ <b>Фаза 1 (Шторм)</b> — уникай торнадо, збирай бонуси</p>
        <p>🌪️ <b>Фаза 2 (Торнадо)</b> — одне велике торнадо! Хто перший доторкнеться — перемагає!</p>
        <p>💀 Якщо торнадо зловить тебе — ти вибуваєш!</p>
        <p>🏆 Переможець — той, хто першим доторкнеться до фінального торнадо!</p>
    </div>
    <button class="menu-btn back-btn" onclick="hideHowTo()">⬅️ Назад</button>
</div>

<!-- ====== GAME ====== -->
<canvas id="gameCanvas"></canvas>

<div id="gameUI">
    <div id="windRadar">
        <canvas id="radarCanvas" width="150" height="150"></canvas>
    </div>
    <div class="radar-label">🌬️ Радар вітру</div>
    
    <div id="minimap">
        <canvas id="minimapCanvas" width="200" height="200"></canvas>
    </div>
    
    <div id="leaderboard">
        <h3>🏆 Турнірна таблиця</h3>
        <div id="leaderList"></div>
    </div>
    
    <div id="hud">
        <div class="hud-item">
            <div class="label">⛽ Паливо</div>
            <div class="value" id="fuelDisplay">100%</div>
        </div>
        <div class="hud-item">
            <div class="label">❤️ Здоров'я</div>
            <div class="value" id="healthDisplay">100%</div>
        </div>
        <div class="hud-item">
            <div class="label">⚡ Швидкість</div>
            <div class="value" id="speedDisplay">0</div>
        </div>
        <div class="hud-item">
            <div class="label">🌪️ Фаза</div>
            <div class="value" id="phaseDisplay">Шторм</div>
        </div>
        <div class="hud-item">
            <div class="label">⏱️ Час</div>
            <div class="value" id="timeDisplay">0:00</div>
        </div>
    </div>
    
    <div id="phaseIndicator"></div>
    <div id="messages"></div>
</div>

<!-- ====== DEATH SCREEN ====== -->
<div id="deathScreen">
    <div class="skull">💀</div>
    <h2>ТОРНАДО ЗНИЩИЛО ТЕБЕ!</h2>
    <p id="deathReason" style="font-size:1.3em; margin-bottom:20px;">Ти був затягнутий у вихор...</p>
    <p id="finalScore" style="font-size:1.5em; color:#ffd700; margin-bottom:30px;"></p>
    <button class="menu-btn" onclick="backToMenu()">🏠 Меню</button>
    <button class="menu-btn" onclick="startGame()">🔄 Заново</button>
</div>

<script>
// ==================== GAME ENGINE ====================

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const radarCanvas = document.getElementById('radarCanvas');
const radarCtx = radarCanvas.getContext('2d');
const minimapCanvas = document.getElementById('minimapCanvas');
const minimapCtx = minimapCanvas.getContext('2d');

// Game state
let gameRunning = false;
let gameTime = 0;
let phase = 'storm'; // 'storm' or 'tornado'
let phaseTime = 0;
let camera = { x: 0, y: 0 };
let particles = [];
let rainDrops = [];
let screenShake = 0;

// Map size
const MAP_WIDTH = 4000;
const MAP_HEIGHT = 4000;

// Settings
let playerName = localStorage.getItem('tornado_name') || 'Гравець';
let sensitivity = 5;
let volume = 70;

// Stats
let bestScore = parseInt(localStorage.getItem('tornado_best') || '0');
let gamesPlayed = parseInt(localStorage.getItem('tornado_games') || '0');
let wins = parseInt(localStorage.getItem('tornado_wins') || '0');

// Update menu stats
document.getElementById('bestScore').textContent = bestScore;
document.getElementById('gamesPlayed').textContent = gamesPlayed;
document.getElementById('wins').textContent = wins;

// ==================== CLASSES ====================

class Vector2 {
    constructor(x, y) { this.x = x; this.y = y; }
    add(v) { return new Vector2(this.x + v.x, this.y + v.y); }
    sub(v) { return new Vector2(this.x - v.x, this.y - v.y); }
    mult(s) { return new Vector2(this.x * s, this.y * s); }
    mag() { return Math.sqrt(this.x * this.x + this.y * this.y); }
    normalize() {
        const m = this.mag();
        return m > 0 ? new Vector2(this.x / m, this.y / m) : new Vector2(0, 0);
    }
    dist(v) { return Math.sqrt((this.x - v.x) ** 2 + (this.y - v.y) ** 2); }
}

class Car {
    constructor(x, y, color, name, isPlayer = false) {
        this.pos = new Vector2(x, y);
        this.vel = new Vector2(0, 0);
        this.angle = Math.random() * Math.PI * 2;
        this.speed = 0;
        this.maxSpeed = isPlayer ? 8 : 6 + Math.random() * 3;
        this.accel = 0.3;
        this.friction = 0.95;
        this.turnSpeed = 0.08;
        this.color = color;
        this.name = name;
        this.isPlayer = isPlayer;
        this.fuel = 100;
        this.health = 100;
        this.alive = true;
        this.width = 24;
        this.height = 14;
        this.trail = [];
        this.aiTarget = null;
        this.aiChangeTimer = 0;
        this.score = 0;
    }

    update(keys) {
        if (!this.alive) return;

        if (this.isPlayer) {
            // Player controls
            const sens = sensitivity / 5;
            if (keys['w'] || keys['arrowup']) {
                this.speed += this.accel * sens;
            }
            if (keys['s'] || keys['arrowdown']) {
                this.speed -= this.accel * sens;
            }
            if (keys['a'] || keys['arrowleft']) {
                this.angle -= this.turnSpeed * sens * (Math.abs(this.speed) / this.maxSpeed + 0.2);
            }
            if (keys['d'] || keys['arrowright']) {
                this.angle += this.turnSpeed * sens * (Math.abs(this.speed) / this.maxSpeed + 0.2);
            }
        } else {
            // AI behavior
            this.aiUpdate();
        }

        // Cap speed
        this.speed = Math.max(-this.maxSpeed * 0.5, Math.min(this.maxSpeed, this.speed));
        
        // Friction
        this.speed *= this.friction;

        // Fuel consumption
        if (Math.abs(this.speed) > 0.1) {
            this.fuel -= 0.03;
        }
        if (this.fuel <= 0) {
            this.speed *= 0.99;
            if (this.speed < 0.5) this.speed = 0;
        }

        // Calculate velocity
        this.vel.x = Math.cos(this.angle) * this.speed;
        this.vel.y = Math.sin(this.angle) * this.speed;

        // Update position
        this.pos.x += this.vel.x;
        this.pos.y += this.vel.y;

        // Boundary check
        this.pos.x = Math.max(50, Math.min(MAP_WIDTH - 50, this.pos.x));
        this.pos.y = Math.max(50, Math.min(MAP_HEIGHT - 50, this.pos.y));

        // Trail
        if (Math.abs(this.speed) > 1) {
            this.trail.push({ x: this.pos.x, y: this.pos.y, life: 20 });
        }
        this.trail = this.trail.filter(t => {
            t.life--;
            return t.life > 0;
        });
    }

    aiUpdate() {
        this.aiChangeTimer--;
        
        // Find nearest tornado to avoid (storm phase) or chase (tornado phase)
        let target = null;
        let minDist = Infinity;
        
        for (let t of tornadoes) {
            const d = this.pos.dist(t.pos);
            if (d < minDist) {
                minDist = d;
                target = t;
            }
        }

        if (phase === 'storm') {
            // AVOID tornadoes
            if (target && minDist < 300) {
                const away = this.pos.sub(target.pos).normalize();
                this.aiTarget = this.pos.add(away.mult(400));
            }
        } else {
            // CHASE the big tornado
            if (target) {
                this.aiTarget = target.pos;
            }
        }

        // Also seek gas stations if low fuel
        if (this.fuel < 30) {
            let nearestGas = null;
            let minGasDist = Infinity;
            for (let g of gasStations) {
                const d = this.pos.dist(new Vector2(g.x, g.y));
                if (d < minGasDist) {
                    minGasDist = d;
                    nearestGas = g;
                }
            }
            if (nearestGas) {
                this.aiTarget = new Vector2(nearestGas.x, nearestGas.y);
            }
        }

        // Random wandering
        if (!this.aiTarget || this.aiChangeTimer <= 0) {
            this.aiTarget = new Vector2(
                200 + Math.random() * (MAP_WIDTH - 400),
                200 + Math.random() * (MAP_HEIGHT - 400)
            );
            this.aiChangeTimer = 100 + Math.random() * 200;
        }

        // Steer toward target
        if (this.aiTarget) {
            const dir = this.aiTarget.sub(this.pos);
            const targetAngle = Math.atan2(dir.y, dir.x);
            let diff = targetAngle - this.angle;
            while (diff > Math.PI) diff -= Math.PI * 2;
            while (diff < -Math.PI) diff += Math.PI * 2;
            
            this.angle += Math.sign(diff) * Math.min(Math.abs(diff), this.turnSpeed);
            this.speed += this.accel;
        }
    }

    draw(ctx, camX, camY) {
        if (!this.alive) return;

        const x = this.pos.x - camX;
        const y = this.pos.y - camY;

        // Trail
        ctx.strokeStyle = this.color + '40';
        ctx.lineWidth = 3;
        ctx.beginPath();
        for (let i = 0; i < this.trail.length - 1; i++) {
            ctx.moveTo(this.trail[i].x - camX, this.trail[i].y - camY);
            ctx.lineTo(this.trail[i + 1].x - camX, this.trail[i + 1].y - camY);
        }
        ctx.stroke();

        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(this.angle);

        // Shadow
        ctx.fillStyle = 'rgba(0,0,0,0.3)';
        ctx.fillRect(-this.width/2 + 3, -this.height/2 + 3, this.width, this.height);

        // Car body
        ctx.fillStyle = this.color;
        ctx.fillRect(-this.width/2, -this.height/2, this.width, this.height);

        // Car details
        ctx.fillStyle = '#333';
        ctx.fillRect(-this.width/2 + 2, -this.height/2 + 2, this.width - 4, this.height - 4);
        
        ctx.fillStyle = this.color;
        ctx.fillRect(-this.width/2 + 4, -this.height/2 + 4, this.width - 8, this.height - 8);

        // Windshield
        ctx.fillStyle = '#87CEEB';
        ctx.fillRect(2, -this.height/2 + 3, 8, this.height - 6);

        // Headlights
        ctx.fillStyle = '#ffffaa';
        ctx.fillRect(this.width/2 - 2, -this.height/2 + 1, 3, 3);
        ctx.fillRect(this.width/2 - 2, this.height/2 - 4, 3, 3);

        // Taillights
        ctx.fillStyle = '#ff4444';
        ctx.fillRect(-this.width/2, -this.height/2 + 1, 2, 3);
        ctx.fillRect(-this.width/2, this.height/2 - 4, 2, 3);

        ctx.restore();

        // Name tag
        ctx.fillStyle = 'white';
        ctx.font = 'bold 11px Arial';
        ctx.textAlign = 'center';
        ctx.fillText(this.name, x, y - 20);

        // Health bar
        const barWidth = 30;
        const barHeight = 4;
        ctx.fillStyle = '#333';
        ctx.fillRect(x - barWidth/2, y - 15, barWidth, barHeight);
        ctx.fillStyle = this.health > 50 ? '#0f0' : this.health > 25 ? '#ff0' : '#f00';
        ctx.fillRect(x - barWidth/2, y - 15, barWidth * (this.health / 100), barHeight);

        // Fuel indicator (only for player)
        if (this.isPlayer) {
            ctx.fillStyle = '#333';
            ctx.fillRect(x - barWidth/2, y - 10, barWidth, barHeight);
            ctx.fillStyle = this.fuel > 30 ? '#00aaff' : '#ff6600';
            ctx.fillRect(x - barWidth/2, y - 10, barWidth * (this.fuel / 100), barHeight);
        }
    }
}

class Tornado {
    constructor(x, y, size = 'medium') {
        this.pos = new Vector2(x, y);
        this.baseX = x;
        this.baseY = y;
        this.size = size;
        this.radius = size === 'small' ? 40 : size === 'medium' ? 80 : 150;
        this.angle = 0;
        this.speed = size === 'small' ? 2 : size === 'medium' ? 1.5 : 1;
        this.wobble = 0;
        this.particles = [];
        this.life = 0;
        this.isFinal = false;
    }

    update() {
        this.life++;
        this.angle += 0.05;
        this.wobble += 0.02;

        // Move in figure-8 or random pattern
        if (this.size === 'large') {
            // Final tornado moves slowly toward center
            const center = new Vector2(MAP_WIDTH/2, MAP_HEIGHT/2);
            const toCenter = center.sub(this.pos).normalize().mult(0.5);
            this.pos = this.pos.add(toCenter);
        } else {
            this.pos.x = this.baseX + Math.sin(this.wobble) * 200;
            this.pos.y = this.baseY + Math.cos(this.wobble * 0.7) * 150;
        }

        // Spawn particles
        for (let i = 0; i < 3; i++) {
            const angle = Math.random() * Math.PI * 2;
            const dist = Math.random() * this.radius;
            this.particles.push({
                x: this.pos.x + Math.cos(angle) * dist,
                y: this.pos.y + Math.sin(angle) * dist,
                vx: Math.cos(angle + Math.PI/2) * (2 + Math.random() * 3),
                vy: Math.sin(angle + Math.PI/2) * (2 + Math.random() * 3),
                life: 30 + Math.random() * 30,
                size: 3 + Math.random() * 8,
                color: `hsl(${200 + Math.random() * 40}, 60%, ${30 + Math.random() * 30}%)`
            });
        }

        // Update particles
        this.particles = this.particles.filter(p => {
            p.x += p.vx;
            p.y += p.vy;
            p.vx *= 0.98;
            p.vy *= 0.98;
            // Spiral inward
            const toCenter = this.pos.sub(new Vector2(p.x, p.y)).normalize().mult(0.3);
            p.vx += toCenter.x;
            p.vy += toCenter.y;
            p.life--;
            return p.life > 0;
        });
    }

    draw(ctx, camX, camY) {
        // Draw particles
        for (let p of this.particles) {
            const alpha = p.life / 60;
            ctx.fillStyle = p.color.replace(')', `, ${alpha})`).replace('hsl', 'hsla');
            ctx.beginPath();
            ctx.arc(p.x - camX, p.y - camY, p.size * (p.life / 60), 0, Math.PI * 2);
            ctx.fill();
        }

        // Draw funnel
        const x = this.pos.x - camX;
        const y = this.pos.y - camY;

        // Outer glow
        const gradient = ctx.createRadialGradient(x, y, 0, x, y, this.radius * 1.5);
        gradient.addColorStop(0, 'rgba(100, 100, 120, 0.3)');
        gradient.addColorStop(0.5, 'rgba(80, 80, 100, 0.2)');
        gradient.addColorStop(1, 'rgba(60, 60, 80, 0)');
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(x, y, this.radius * 1.5, 0, Math.PI * 2);
        ctx.fill();

        // Main funnel
        for (let i = 0; i < 5; i++) {
            const r = this.radius * (1 - i * 0.15);
            const offset = i * 8;
            ctx.strokeStyle = `rgba(${100 + i * 20}, ${100 + i * 20}, ${120 + i * 10}, ${0.6 - i * 0.1})`;
            ctx.lineWidth = 3 - i * 0.4;
            ctx.beginPath();
            for (let a = 0; a < Math.PI * 2; a += 0.1) {
                const spiral = a + this.angle + i * 0.5;
                const px = x + Math.cos(spiral) * r;
                const py = y + Math.sin(spiral) * r + offset;
                if (a === 0) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            }
            ctx.closePath();
            ctx.stroke();
        }

        // Core
        ctx.fillStyle = 'rgba(40, 40, 60, 0.8)';
        ctx.beginPath();
        ctx.arc(x, y, this.radius * 0.3, 0, Math.PI * 2);
        ctx.fill();

        // Lightning
        if (Math.random() < 0.05) {
            ctx.strokeStyle = '#aaaaff';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(x, y - this.radius);
            for (let i = 0; i < 5; i++) {
                ctx.lineTo(
                    x + (Math.random() - 0.5) * 40,
                    y - this.radius + i * (this.radius * 2 / 5)
                );
            }
            ctx.stroke();
        }

        // Label for final tornado
        if (this.isFinal) {
            ctx.fillStyle = '#ffd700';
            ctx.font = 'bold 16px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('★ ФІНАЛЬНЕ ТОРНАДО ★', x, y - this.radius - 20);
        }
    }
}

class Interceptor {
    constructor(x, y) {
        this.pos = new Vector2(x, y);
        this.deployed = false;
        this.target = null;
        this.speed = 4;
        this.angle = 0;
        this.life = 0;
    }

    update() {
        this.life++;
        if (!this.deployed) return;

        // Find nearest tornado
        let nearest = null;
        let minDist = Infinity;
        for (let t of tornadoes) {
            const d = this.pos.dist(t.pos);
            if (d < minDist) {
                minDist = d;
                nearest = t;
            }
        }

        if (nearest) {
            const dir = nearest.pos.sub(this.pos).normalize();
            this.angle = Math.atan2(dir.y, dir.x);
            this.pos = this.pos.add(dir.mult(this.speed));
        }

        // Check collision with tornado
        if (nearest && this.pos.dist(nearest.pos) < nearest.radius) {
            // Damage tornado
            nearest.radius = Math.max(20, nearest.radius - 15);
            this.deployed = false;
            addMessage('💥 Перехоплювач влучив у торнадо!', '#ff6666');
            screenShake = 10;
        }
    }

    draw(ctx, camX, camY) {
        if (!this.deployed) return;
        const x = this.pos.x - camX;
        const y = this.pos.y - camY;

        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(this.angle);

        // Rocket body
        ctx.fillStyle = '#cc3333';
        ctx.fillRect(-8, -3, 16, 6);
        
        // Nose
        ctx.fillStyle = '#ff6666';
        ctx.beginPath();
        ctx.moveTo(8, -3);
        ctx.lineTo(12, 0);
        ctx.lineTo(8, 3);
        ctx.fill();

        // Fins
        ctx.fillStyle = '#aa2222';
        ctx.fillRect(-6, -5, 4, 2);
        ctx.fillRect(-6, 3, 4, 2);

        // Flame
        ctx.fillStyle = `rgba(255, ${100 + Math.random() * 155}, 0, 0.8)`;
        ctx.beginPath();
        ctx.moveTo(-8, -2);
        ctx.lineTo(-12 - Math.random() * 8, 0);
        ctx.lineTo(-8, 2);
        ctx.fill();

        ctx.restore();
    }
}

